#!/bin/bash

# QC-Leap Development Server
# Starts backend, frontend, and all required services

set -e  # Exit on error

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Project root
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND_DIR="$PROJECT_ROOT/backend"
FRONTEND_DIR="$PROJECT_ROOT/frontend"
PID_FILE="$PROJECT_ROOT/.dev_pids"

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  QC-Leap Development Server${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# Function to print status
print_status() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

print_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

# Function to check if a command exists
command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# Function to check if a service is running
check_service() {
    if pgrep -x "$1" > /dev/null; then
        return 0
    else
        return 1
    fi
}

# Function to wait for HTTP service to be ready
wait_for_port() {
    local port=$1
    local max_wait=45  # Increased for Next.js compilation time
    local waited=0

    while true; do
        # Try HTTP request - this ensures the service is actually responding
        if curl -s -o /dev/null -w "%{http_code}" http://localhost:$port 2>/dev/null | grep -q '^[23]'; then
            return 0
        fi

        if [ $waited -ge $max_wait ]; then
            return 1
        fi

        sleep 1
        waited=$((waited + 1))
    done
}

# Cleanup function
cleanup() {
    echo ""
    print_info "Shutting down services..."

    if [ -f "$PID_FILE" ]; then
        while IFS= read -r pid; do
            if kill -0 $pid 2>/dev/null; then
                kill $pid 2>/dev/null || true
            fi
        done < "$PID_FILE"
        rm -f "$PID_FILE"
    fi

    # Kill any remaining processes on our ports
    lsof -ti:8000 | xargs kill -9 2>/dev/null || true
    lsof -ti:3000 | xargs kill -9 2>/dev/null || true

    # If running on WSL, also kill Windows Node.js processes
    if grep -q Microsoft /proc/version 2>/dev/null; then
        cmd.exe /c "taskkill /F /IM node.exe 2>nul" 2>/dev/null || true
    fi

    print_status "Cleanup complete"
    exit 0
}

trap cleanup INT TERM

# Clear old PID file
rm -f "$PID_FILE"

echo "Checking prerequisites..."
echo ""

# Check Python
if ! command_exists python3; then
    print_error "Python 3 not found. Please install Python 3.10+"
    exit 1
fi
print_status "Python 3 installed"

# Check if virtual environment exists
if [ ! -d "$BACKEND_DIR/.venv" ]; then
    print_error "Virtual environment not found. Run: cd backend && ./setup.sh"
    exit 1
fi
print_status "Virtual environment found"

# Check PostgreSQL
echo ""
print_info "Checking PostgreSQL..."
if ! check_service "postgres"; then
    print_warning "PostgreSQL not running. Attempting to start..."
    sudo service postgresql start 2>/dev/null || {
        print_error "Failed to start PostgreSQL. Please start it manually:"
        echo "  sudo service postgresql start"
        exit 1
    }
    sleep 2
fi

if check_service "postgres"; then
    print_status "PostgreSQL is running"
else
    print_error "PostgreSQL is not running"
    exit 1
fi

# Check if database exists
echo ""
print_info "Checking database..."
if sudo -u postgres psql -lqt | cut -d \| -f 1 | grep -qw qc_leap_db; then
    print_status "Database 'qc_leap_db' exists"
else
    print_warning "Database not found. Creating..."
    sudo -u postgres psql << EOF
CREATE DATABASE qc_leap_db;
CREATE USER qc_leap_user WITH PASSWORD 'QcL3ap_S3cur3_P@ssw0rd_2024';
GRANT ALL PRIVILEGES ON DATABASE qc_leap_db TO qc_leap_user;
EOF
    print_status "Database created"
fi

# Check Redis
echo ""
print_info "Checking Redis..."
if ! check_service "redis-server"; then
    print_warning "Redis not running. Attempting to start..."
    sudo service redis-server start 2>/dev/null || {
        print_warning "Redis not available. Running without cache."
    }
    sleep 1
fi

if check_service "redis-server"; then
    print_status "Redis is running"
else
    print_warning "Redis not running (optional - caching disabled)"
fi

# Database tables will be created automatically by SQLAlchemy
echo ""
print_status "Database ready (tables will be auto-created on startup)"

# Kill any processes on our ports
echo ""
print_info "Cleaning up ports..."

# Kill WSL processes
lsof -ti:8000 | xargs kill -9 2>/dev/null || true
lsof -ti:3000 | xargs kill -9 2>/dev/null || true

# If running on WSL, kill Windows processes more aggressively
if grep -q Microsoft /proc/version 2>/dev/null; then
    # Kill all Node.js processes
    cmd.exe /c "taskkill /F /IM node.exe 2>nul" 2>/dev/null || true

    # Use PowerShell to kill processes on specific ports
fi

# Remove Next.js lock file and build cache
rm -rf "$FRONTEND_DIR/.next/dev/lock" 2>/dev/null || true

# Wait for ports to be fully released
sleep 3
powershell.exe -ExecutionPolicy Bypass -File "$PROJECT_ROOT/kill_ports.ps1" -Ports 3000,8000 2>/dev/null || true


# Remove Next.js lock file and build cache
rm -rf "$FRONTEND_DIR/.next/dev/lock" 2>/dev/null || true

# Wait for ports to be fully released
sleep 3

# Start Backend
echo ""
print_info "Starting backend server..."
cd "$BACKEND_DIR"
source .venv/bin/activate
uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload > "$PROJECT_ROOT/backend.log" 2>&1 &
BACKEND_PID=$!
echo $BACKEND_PID >> "$PID_FILE"

# Wait for backend to be ready
if wait_for_port 8000; then
    print_status "Backend server running on http://localhost:8000"
else
    print_error "Backend failed to start. Check backend.log for details."
    cleanup
fi

# Start Frontend (Next.js)
echo ""
print_info "Starting Next.js frontend..."
cd "$FRONTEND_DIR"

# Check if node_modules exists, if not install dependencies
if [ ! -d "node_modules" ]; then
    print_info "Installing frontend dependencies (first time setup)..."
    npm install > "$PROJECT_ROOT/frontend.log" 2>&1
fi

npm run dev > "$PROJECT_ROOT/frontend.log" 2>&1 &
FRONTEND_PID=$!
echo $FRONTEND_PID >> "$PID_FILE"

# Wait for frontend to be ready
if wait_for_port 3000; then
    print_status "Frontend server running on http://localhost:3000"
else
    print_error "Frontend failed to start. Check frontend.log for details."
    cleanup
fi

# Health check
echo ""
print_info "Running health check..."
sleep 2

if curl -s http://localhost:8000/api/v1/health/ > /dev/null; then
    print_status "Backend health check passed"
else
    print_warning "Backend health check failed (might still be starting)"
fi

# Print summary
echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}  🚀 QC-Leap is running!${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "  ${BLUE}Frontend:${NC}     http://localhost:3000"
echo -e "  ${BLUE}Backend API:${NC}  http://localhost:8000"
echo -e "  ${BLUE}API Docs:${NC}     http://localhost:8000/api/v1/docs"
echo -e "  ${BLUE}Health:${NC}       http://localhost:8000/api/v1/health/"
echo ""
echo -e "  ${YELLOW}Logs:${NC}"
echo -e "    Backend:  tail -f backend.log"
echo -e "    Frontend: tail -f frontend.log"
echo ""
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
print_info "Press Ctrl+C to stop all servers"
echo ""

# Try to open browser
if command_exists xdg-open; then
    sleep 2
    xdg-open http://localhost:3000 2>/dev/null &
    print_info "Opening frontend in browser..."
elif command_exists open; then
    sleep 2
    open http://localhost:3000 2>/dev/null &
    print_info "Opening frontend in browser..."
fi

echo ""
print_info "Database Connection Info (for Windows pgAdmin):"
echo "  Host: localhost"
echo "  Port: 5433"
echo "  Database: qc_leap_db"
echo "  Username: qc_leap_user"
echo "  Password: QcL3ap_S3cur3_P@ssw0rd_2024"

# Keep script running and monitor processes
while true; do
    # Check if backend is still running
    if ! kill -0 $BACKEND_PID 2>/dev/null; then
        print_error "Backend server stopped unexpectedly!"
        cleanup
    fi

    # Check if frontend is still running
    if ! kill -0 $FRONTEND_PID 2>/dev/null; then
        print_error "Frontend server stopped unexpectedly!"
        cleanup
    fi

    sleep 5
done
